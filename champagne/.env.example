# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Service role key: alleen server-side gebruikt (API routes), nooit in de browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Sleutel voor /admin?key=...
ADMIN_KEY=verzin-iets-langs-en-willekeurigs

# Naam van de publieke storage bucket met de foto's
SUPABASE_PHOTO_BUCKET=champagne-photos
